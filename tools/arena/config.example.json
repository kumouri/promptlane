      "avgSecPerCall": 0.9,
      "timeoutSec": 60
    },
    "openrouter-qwen32b": {
      "kind": "http",
      "endpoint": "http://127.0.0.1:8789/",
      "model": "qwen/qwen3-32b",
      "avgSecPerCall": 1.4,
      "timeoutSec": 60,
      "concurrency": 6,
      "usdPerMToken": { "in": 0.08, "out": 0.28 },
      "dailyBudgetUsd": 5
    },
    "mock": { "kind": "mock", "model": "mock", "avgSecPerCall": 0.001 }
  },
  "entrants": { "kind": "gh", "repo": "kumouri/jamobair-entrants", "ref": "main", "syncIntervalSec": 60 },
  "house": {
    "handle": "house",
    "files": [
      { "violet": "prompts/pilots/house-violet.md", "green": "prompts/pilots/house-green.md" },
      "prompts/pilots/house.md",
      "prompts/pilots/drums.md"
    ]
  },
  "organizerEmail": "CHANGE-ME@inrhythm.com"
}
