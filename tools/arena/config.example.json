{
  "tournament": {
    "id": "ladder",
    "name": "Pre-jam ladder",
    "backend": "qwen9b",
    "cadenceSec": 2,
    "maxSimSec": 600,
    "quick": { "maxSimSec": 180, "cadenceSec": 4, "seed": 7 },
    "placementSeeds": [7, 11, 42],
    "quota": { "quick": 6, "full": 2 }
  },
  "backends": {
    "qwen9b": {
      "kind": "http",
      "endpoint": "http://127.0.0.1:8787/",
